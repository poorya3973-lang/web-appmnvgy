{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appmnvgy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9ca7acb4-834a-40ef-9bf0-c03f0615112a","database_name": "web-appzlkijuh" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c96bec96d4444b5cb9cab57b41a302b2" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
